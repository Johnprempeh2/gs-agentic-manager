{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gs-site-contract/deep-dive-sync",
  "title": "PUT /api/admin/v1/deep-dive/tenants/:tenantId: GSAM's whole snapshot of one tenant (GRE-2439)",
  "type": "object",
  "required": ["schema", "tenantId", "tenantName", "generatedAt", "items", "files", "documentRequests", "deliverables", "findings", "opportunities", "kpis"],
  "additionalProperties": false,
  "definitions": {
    "id": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "nullableTime": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "nullableString": { "type": ["string", "null"] }
  },
  "properties": {
    "schema": { "const": "gs-deep-dive-sync-v1" },
    "tenantId": { "type": "string", "format": "uuid" },
    "tenantName": { "type": "string" },
    "generatedAt": { "$ref": "#/definitions/time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "key", "title", "summary", "status", "fields", "parentId", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "type": { "type": "string" },
          "key": { "$ref": "#/definitions/nullableString" },
          "title": { "type": "string" },
          "summary": { "$ref": "#/definitions/nullableString" },
          "status": { "type": "string" },
          "fields": { "type": "object" },
          "parentId": { "$ref": "#/definitions/nullableString" },
          "updatedAt": { "$ref": "#/definitions/time" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemId", "title", "kind", "status", "heldAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "itemId": { "$ref": "#/definitions/id" },
          "title": { "type": "string" },
          "kind": { "$ref": "#/definitions/nullableString" },
          "status": { "enum": ["held", "missing"] },
          "heldAt": { "$ref": "#/definitions/nullableTime" }
        }
      }
    },
    "documentRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "note", "itemIds", "status", "receivedAt", "createdAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string" },
          "note": { "$ref": "#/definitions/nullableString" },
          "itemIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "status": { "enum": ["open", "received"] },
          "receivedAt": { "$ref": "#/definitions/nullableTime" },
          "createdAt": { "$ref": "#/definitions/time" }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "version", "status", "publishedAt", "acceptedAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string" },
          "version": { "type": ["integer", "null"] },
          "status": { "enum": ["published", "accepted"] },
          "publishedAt": { "$ref": "#/definitions/time" },
          "acceptedAt": { "$ref": "#/definitions/nullableTime" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "streamItemId", "statement", "status", "evidenceCount", "supersedesId", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "streamItemId": { "$ref": "#/definitions/nullableString" },
          "statement": { "type": "string" },
          "status": { "enum": ["proposed", "validated", "rejected", "superseded"] },
          "evidenceCount": { "type": "integer", "minimum": 0 },
          "supersedesId": { "$ref": "#/definitions/nullableString" },
          "updatedAt": { "$ref": "#/definitions/time" }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ref", "title", "statement", "desiredOutcome", "status", "findingIds", "streamItemIds", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "ref": { "type": "string" },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "desiredOutcome": { "type": "string" },
          "status": { "enum": ["draft", "refined", "validated"] },
          "findingIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "streamItemIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "updatedAt": { "$ref": "#/definitions/time" }
        }
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "definition", "scope", "unit", "direction", "baseline", "baselinePeriod", "target", "opportunityIds", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string" },
          "definition": { "type": "string" },
          "scope": { "enum": ["company", "division", "department", "team", "individual"] },
          "unit": { "type": "string" },
          "direction": { "enum": ["up", "down", "steady"] },
          "baseline": { "type": "number" },
          "baselinePeriod": { "type": "string" },
          "target": { "type": "number" },
          "opportunityIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "updatedAt": { "$ref": "#/definitions/time" }
        }
      }
    }
  }
}
