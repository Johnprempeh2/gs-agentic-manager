{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gs-site-contract/bridge-health",
  "title": "GET /api/admin/v1/health: the site's answer to a signed gs-bridge-v1 read",
  "type": "object",
  "required": ["ok", "kid", "capability", "serverTime", "schema", "siteContract"],
  "properties": {
    "ok": { "const": true },
    "kid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "capability": { "enum": ["read", "write", "refund_request"] },
    "serverTime": { "type": "string", "format": "date-time" },
    "schema": { "const": "gs-bridge-v1" },
    "siteContract": { "type": "integer", "minimum": 1 }
  }
}
