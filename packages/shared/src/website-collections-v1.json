{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greatstone:website-collections:1",
  "title": "Greatstone public website collection fields, version 1",
  "description": "Validate entry.fields (not the release entry envelope). The object keys below are release collection keys. Studio staff accounts are excluded.",
  "$defs": {
    "text": { "type": "string", "maxLength": 10000 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "slug": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "image": { "type": "string", "maxLength": 2048 },
    "nullableText": { "type": ["string", "null"], "maxLength": 2000 },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value", "sort_order"],
      "properties": { "label": { "$ref": "#/$defs/name" }, "value": { "$ref": "#/$defs/text" }, "sort_order": { "type": "integer", "minimum": 0 } }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sku", "name", "currency", "platform", "sort_order", "license_type", "min_order_qty", "billing_period", "base_price_minor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "sku": { "$ref": "#/$defs/nullableText" },
        "name": { "$ref": "#/$defs/name" }, "currency": { "$ref": "#/$defs/nullableText" },
        "platform": { "$ref": "#/$defs/nullableText" }, "sort_order": { "type": "integer", "minimum": 0 },
        "license_type": { "$ref": "#/$defs/nullableText" }, "min_order_qty": { "type": "integer", "minimum": 1 },
        "billing_period": { "$ref": "#/$defs/nullableText" }, "base_price_minor": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "vendorSummary": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "logo_url"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "$ref": "#/$defs/name" }, "slug": { "$ref": "#/$defs/slug" }, "logo_url": { "$ref": "#/$defs/image" } }
    },
    "categorySummary": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "slug"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "$ref": "#/$defs/name" }, "slug": { "$ref": "#/$defs/slug" } }
    },
    "vendors": {
      "type": "object", "additionalProperties": false, "required": ["data"],
      "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "name", "logo_url", "description"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/slug" }, "name": { "$ref": "#/$defs/name" }, "logo_url": { "$ref": "#/$defs/image" }, "description": { "$ref": "#/$defs/text" } } } }
    },
    "categories": {
      "type": "object", "additionalProperties": false, "required": ["data"],
      "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "name", "description"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/slug" }, "name": { "$ref": "#/$defs/name" }, "description": { "$ref": "#/$defs/text" } } } }
    },
    "offerings": {
      "type": "object", "additionalProperties": false, "required": ["data"],
      "properties": { "data": { "type": "object", "additionalProperties": false,
        "required": ["id", "slug", "name", "short_description", "from_price_minor", "from_price_currency", "featured", "platforms", "type", "attributes", "vendor", "category"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "slug": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "$ref": "#/$defs/name" }, "short_description": { "$ref": "#/$defs/text" },
          "from_price_minor": { "type": ["integer", "null"], "minimum": 0 },
          "from_price_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "featured": { "type": "boolean" }, "platforms": { "type": "array", "items": { "$ref": "#/$defs/name" } },
          "type": { "enum": ["product"] },
          "attributes": { "type": "object", "additionalProperties": false,
            "properties": { "icon": { "$ref": "#/$defs/image" }, "gallery": { "type": "array", "items": { "$ref": "#/$defs/image" } }, "mainImage": { "$ref": "#/$defs/image" }, "sourceUrl": { "$ref": "#/$defs/image" } } },
          "vendor": { "$ref": "#/$defs/vendorSummary" }, "category": { "$ref": "#/$defs/categorySummary" },
          "description": { "$ref": "#/$defs/text" },
          "seo": { "type": "object", "additionalProperties": false,
            "properties": { "metaTitle": { "$ref": "#/$defs/text" }, "metaDescription": { "$ref": "#/$defs/text" }, "socialImage": { "$ref": "#/$defs/image" } } },
          "offering_variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
          "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
          "offering_specs": { "type": "array", "items": { "$ref": "#/$defs/spec" } },
          "specs": { "type": "array", "items": { "$ref": "#/$defs/spec" } }
        }
      } }
    },
    "public-people": {
      "type": "object", "additionalProperties": false, "required": ["name", "role", "kind"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "role": { "$ref": "#/$defs/text" }, "kind": { "enum": ["person", "role"] }, "photo": { "$ref": "#/$defs/image" } }
    },
    "forms": {
      "type": "object", "additionalProperties": false, "required": ["key", "title", "fields", "submitLabel"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" }, "title": { "$ref": "#/$defs/name" },
        "intro": { "$ref": "#/$defs/text" }, "submitLabel": { "$ref": "#/$defs/name" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/formField" } }
      }
    },
    "formField": {
      "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" }, "label": { "$ref": "#/$defs/name" },
        "type": { "enum": ["text", "email", "tel", "textarea", "select", "checkbox"] },
        "required": { "type": "boolean" }, "placeholder": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["value", "label"], "properties": { "value": { "$ref": "#/$defs/name" }, "label": { "$ref": "#/$defs/name" } } } }
      },
      "if": { "properties": { "type": { "const": "select" } } }, "then": { "required": ["options"] }
    },
    "redirects": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "pattern": "^/(?!/)[^?#]*$" },
        "to": { "type": "string", "pattern": "^(?:/(?!/)|https://)" },
        "status": { "enum": [301, 302, 307, 308] }
      }
    }
  }
}
