{
  "name": "@greatstone/shared",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/Johnprempeh2/GS-Clip",
  "bugs": {
    "url": "https://github.com/Johnprempeh2/GS-Clip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Johnprempeh2/GS-Clip",
    "directory": "packages/shared"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./telemetry": {
        "types": "./dist/telemetry/index.d.ts",
        "import": "./dist/telemetry/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/cliplab', { recursive: true }); for (const f of ['LICENSE', 'PROVENANCE.md']) fs.copyFileSync('src/cliplab/' + f, 'dist/cliplab/' + f);\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "@types/three": "0.185.4"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
