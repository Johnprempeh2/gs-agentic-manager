{
  "id": "/",
  "name": "GS Agentic Manager",
  "short_name": "GS Agents",
  "description": "Greatstone's control plane for running teams of AI agents: goals, tasks, budgets and approvals in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#121212",
  "background_color": "#121212",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "What needs me",
      "short_name": "Decisions",
      "url": "/decisions"
    },
    {
      "name": "My inbox",
      "short_name": "Inbox",
      "url": "/inbox/mine"
    },
    {
      "name": "Your morning",
      "short_name": "Morning",
      "url": "/morning"
    },
    {
      "name": "New task",
      "short_name": "New task",
      "url": "/issues/new"
    }
  ],
  "share_target": {
    "action": "/issues/new",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
