+/**
+ * True when a successful `result` is the CLI's login prompt rather than model
+ * output. The CLI only writes "Please run /login" into `result` when no real
+ * model answered the turn (the assistant message was `<synthetic>`). Once a
+ * real model has answered, `result` is that model's own text, which may quote
+ * the phrase (for example an agent writing up a login bug), so it must not
+ * fail the turn as auth_required. A mid-turn login loss still arrives as a
+ * synthetic assistant message and is caught by `isSyntheticLoginMessage`.
+ */
+export function isLoginRequiredResult(result, lastAssistantModel) {
+    return (lastAssistantModel === null &&
+        typeof result === "string" &&
+        result.includes("Please run /login"));
+}
