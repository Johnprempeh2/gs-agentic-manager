<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shared memory sync (GRE-2668). install-mac.sh fills the @...@ values. Every 30 minutes, low priority. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.greatstone.gs-memory-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@BIN@/gs-memory-sync.mjs</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
