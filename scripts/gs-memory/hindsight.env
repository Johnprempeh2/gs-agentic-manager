# Hindsight engine settings for the organization memory sandbox (GRE-674, G2 change list from GRE-649 5.3).
# No secrets here. gs-memory.sh install fills the @...@ values and writes the result to app/hindsight.env.
# Secrets live in secrets/db.env, secrets/engine.env and (after link-claude) secrets/claude.env.
# secrets/gateway.env is the GSAM server's copy of the key and assertion secret (see link-gateway).

# Loopback only. The default 0.0.0.0 would expose the engine to the tailnet.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=@API_PORT@
HINDSIGHT_API_WORKERS=1
HINDSIGHT_API_LOG_LEVEL=info

# Greatstone extension (GRE-672): every request needs the gateway key and a signed, 60-second assertion from the
# GSAM gateway that names one bank, one operation and the allowed tags. The key and the assertion secret are in
# secrets/engine.env. install copies the extension to app/extension; the engine never reads the repo.
PYTHONPATH=@ROOT@/app/extension
HINDSIGHT_API_TENANT_EXTENSION=gsam_memory_extension:GsamTenantExtension
HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=gsam_memory_extension:GsamOperationValidator
HINDSIGHT_API_EXTENSION_PASSTHROUGH_HEADERS=x-gsam-memory-assertion

# Built-in MCP server off: it exposes delete_bank and clear_memories. Agents use GSAM tools only.
HINDSIGHT_API_MCP_ENABLED=false

# LLM. Provider 'none' until link-claude writes secrets/claude.env (claude-code on John's plan).
# There is no paid fallback: no API key is ever set.
HINDSIGHT_API_LLM_PROVIDER=none
# Prompt log off (GRE-674): full prompts and replies are not stored in the memory database.
HINDSIGHT_API_LLM_TRACE_ENABLED=false

# ADR-0001 MVP: no consolidation and no causal-link extraction.
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_RETAIN_EXTRACT_CAUSAL_LINKS=false

# Local embeddings and reranker, offline after install downloads them.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=true
HF_HOME=@ROOT@/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Nothing else leaves the PC.
LITELLM_LOCAL_MODEL_COST_MAP=True
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
HINDSIGHT_API_FILE_PARSER_ALLOWLIST=markitdown
HINDSIGHT_API_METRICS_INCLUDE_BANK_ID=false
HINDSIGHT_API_METRICS_INCLUDE_TENANT=false

# The Claude CLI spawned by the claude-code provider writes its state here, not in a real home.
HOME=@ROOT@/home
# No telemetry, error reports or update checks from that CLI: only Anthropic model calls leave (GRE-673 egress check).
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
DISABLE_AUTOUPDATER=1
